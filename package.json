{
  "name": "food-hp",
  "version": "1.0.0",
  "private": true,
  "description": "Kose Food AI の静的サイト (site/) と Next.js モノレポ雛形 (apps/, packages/) を同居させたリポジトリ",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve-site.mjs",
    "verify:references": "node scripts/check-site-assets.mjs",
    "verify:lottie": "node scripts/check-lottie-contract.mjs",
    "verify:asset-version": "node scripts/check-asset-version.mjs",
    "verify:i18n": "node scripts/check-i18n-parity.mjs",
    "verify:roadmap": "node scripts/verify-roadmap-evidence.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate \"site/**/*.html\"",
    "lint:css": "stylelint \"site/assets/css/**/*.css\"",
    "lint:js": "eslint site/assets/js scripts tests *.config.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "audit": "pnpm audit --audit-level moderate",
    "check": "npm run verify:references && npm run verify:lottie && npm run verify:asset-version && npm run verify:i18n && npm run lint && npm run test:unit && npm run test:e2e && npm run test:a11y && npm run audit && npm run verify:roadmap",
    "web:dev": "pnpm --filter web dev",
    "web:start": "pnpm --filter web start",
    "web:build": "pnpm -r build",
    "web:lint": "pnpm -r lint",
    "web:test": "pnpm -r test",
    "web:typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "html-validate": "^11.6.2",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "sharp@<0.35.0": ">=0.35.0",
      "brace-expansion@<5.0.8": ">=5.0.8"
    }
  }
}
